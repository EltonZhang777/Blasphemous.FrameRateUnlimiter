<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetName;DefaultPublishFolder;PublishFolderWasSpecified;PublishZipOverwrite">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>

    <Title>Frame Rate Unlimiter</Title>
    <Product>Frame Rate Unlimiter</Product>
    <Authors>NewbieElton</Authors>
    <Company>NewbieElton</Company>
    <Description>Enables frame rate customization (fixed/variable FPS)</Description>
    <Version>1.0.0</Version>

    <TargetName>FrameRateUnlimiter</TargetName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetName).xml</DocumentationFile>
    <RepositoryUrl>https://github.com/EltonZhang777/Blasphemous.FrameRateUnlimiter</RepositoryUrl>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PortableSystemValueTupleVersion>1.0.1</PortableSystemValueTupleVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blasphemous.GameLibs" Version="4.0.67" />
    <PackageReference Include="Blasphemous.ModdingAPI" Version="3.0.1" />
    <PackageReference Include="Portable.System.ValueTuple" Version="$(PortableSystemValueTupleVersion)" />
  </ItemGroup>

  <Target Name="Development" AfterTargets="PostBuildEvent">

    <!-- Get plugin & resources -->
    <ItemGroup>
      <PluginDll Include="$(TargetPath)" />
      <DataDlls Include="$(NuGetPackageRoot)portable.system.valuetuple/$(PortableSystemValueTupleVersion)/lib/net35/Portable.System.ValueTuple.dll" />
      <Resources Include="$(SolutionDir)\resources\**\*.*" />
    </ItemGroup>

    <!-- Get export directories -->
    <PropertyGroup>
      <DevFolder Condition="'$(DevFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Blasphemous\Modding\</DevFolder>
      <PublishFolderWasSpecified Condition="'$(PublishFolder)' != ''">true</PublishFolderWasSpecified>
      <PublishFolderWasSpecified Condition="'$(PublishFolder)' == ''">false</PublishFolderWasSpecified>
      <DefaultPublishFolder>$(MSBuildProjectDirectory)\..\publish\$(TargetName)</DefaultPublishFolder>
      <PublishFolder Condition="'$(PublishFolder)' == ''">$(DefaultPublishFolder)</PublishFolder>
      <PublishZipOverwrite Condition="'$(PublishFolderWasSpecified)' == 'true'">false</PublishZipOverwrite>
      <PublishZipOverwrite Condition="'$(PublishFolderWasSpecified)' != 'true'">true</PublishZipOverwrite>
    </PropertyGroup>

    <Error Condition="'$(PublishFolderWasSpecified)' == 'true' and Exists('$(PublishFolder)')" Text="Custom PublishFolder must be a new directory." />
    <Error Condition="'$(PublishFolderWasSpecified)' == 'true' and Exists('$(PublishFolder)\..\$(TargetName).zip')" Text="Custom ZIP destination already exists; choose a fresh parent directory." />

    <!-- Export to dev folder -->
    <Copy SourceFiles="@(Resources)" DestinationFolder="$(DevFolder)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(DevFolder)\plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataDlls)" DestinationFolder="$(DevFolder)\data" SkipUnchangedFiles="true" />

    <!-- Export to publish folder -->
    <RemoveDir Directories="$(PublishFolder)" Condition="'$(PublishFolderWasSpecified)' != 'true'" />
    <Copy SourceFiles="@(Resources)" DestinationFolder="$(PublishFolder)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(PublishFolder)\plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataDlls)" DestinationFolder="$(PublishFolder)\data" SkipUnchangedFiles="true" />
    <ZipDirectory SourceDirectory="$(PublishFolder)" DestinationFile="$(PublishFolder)\..\$(TargetName).zip" Overwrite="$(PublishZipOverwrite)" />

  </Target>

  <Target Name="AddGeneratedFile" BeforeTargets="BeforeCompile;CoreCompile" Inputs="$(MSBuildAllProjects)" Outputs="$(IntermediateOutputPath)GeneratedFile.cs">

    <!-- Create ModInfo class from relevant data -->
    <PropertyGroup>
      <GeneratedText>
        <![CDATA[ namespace $(RootNamespace) { internal static class ModInfo { public const string MOD_ID = "$(AssemblyName)"%3B public const string MOD_NAME = "$(Product)"%3B public const string MOD_AUTHOR = "$(Company)"%3B public const string MOD_VERSION = "$(Version)"%3B } } ]]>
      </GeneratedText>
      <GeneratedFilePath>$(IntermediateOutputPath)ModInfo.cs</GeneratedFilePath>
    </PropertyGroup>

    <!-- Write ModInfo data to intermediate output -->
    <ItemGroup>
      <Compile Include="$(GeneratedFilePath)" />
      <FileWrites Include="$(GeneratedFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="$(GeneratedText)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="true" Overwrite="true" />

  </Target>
  
</Project>

